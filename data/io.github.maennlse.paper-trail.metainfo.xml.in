<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>@APP_ID@</id>
  <name>@APP_NAME@</name>
  <summary>Local plain-text note taking with a focused GNOME layout</summary>
  <icon type="stock">@APP_ID@</icon>
  <categories>
    <category>Utility</category>
    <category>TextEditor</category>
  </categories>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <description>
    <p>
      Paper Trail is a local-first note taking app for plain text files. Organize
      notes across folders and write in a focused native editor with autosave,
      search, and find and replace.
    </p>
    <p>
      Notes are stored as regular UTF-8 <code>.txt</code> files in a folder you choose.
      Optional end-to-end encrypted sync connects the desktop and terminal clients
      through a separately deployed server. Local-only use needs no account.
    </p>
  </description>
  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/maennlse/paper-trail/main/data/screenshots/desktop.png</image>
      <caption>Recent notes view with the folder sidebar and note preview card.</caption>
    </screenshot>
  </screenshots>
  <launchable type="desktop-id">@APP_ID@.desktop</launchable>
  <developer_name>sm</developer_name>
  <url type="homepage">https://github.com/maennlse/paper-trail</url>
  <url type="bugtracker">https://github.com/maennlse/paper-trail/issues</url>
  <url type="vcs-browser">https://github.com/maennlse/paper-trail</url>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@APP_VERSION@" date="2026-11-08">
      <description>
        <p>Optional end-to-end encrypted sync with multi-folder selection, conflict
        copies, recovery keys, and a non-blocking desktop sync menu. Terminal login
        supports device authorization over SSH.</p>
      </description>
    </release>
  </releases>
</component>
