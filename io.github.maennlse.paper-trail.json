{
  "app-id": "io.github.maennlse.paper-trail",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": ["org.freedesktop.Sdk.Extension.rust-stable"],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin",
    "env": { "CARGO_NET_OFFLINE": "true" }
  },
  "command": "paper-trail",
  "finish-args": [
    "--share=network",
    "--talk-name=org.freedesktop.secrets",
    "--share=ipc",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--device=dri"
  ],
  "cleanup": [
    "/include",
    "/lib/pkgconfig",
    "/share/pkgconfig",
    "/share/man",
    "*.la",
    "*.a"
  ],
  "modules": [
    {
      "name": "paper-trail",
      "buildsystem": "meson",
      "builddir": true,
      "sources": [
        "cargo-sources.json",
        {
          "type": "dir",
          "path": ".",
          "skip": [
            ".git",
            "_build",
            "target",
            "flatpak-build",
            "repo",
            ".flatpak-builder",
            "dist",
            "__pycache__",
            ".venv",
            "venv"
          ]
        }
      ]
    }
  ]
}
